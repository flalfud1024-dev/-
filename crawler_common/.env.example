# =============================================================
# 박사학위논문 크롤러 환경변수 템플릿
#
# 사용법:
#   1. 본 파일을 .env 파일로 복사
#   2. 아래 값을 실제 값으로 채움
#   3. .env는 .gitignore에 등재되어 절대 커밋되지 않음
# =============================================================

# 익명화 salt (사용자 ID SHA-256 해싱용)
# 임의의 긴 문자열, 한 번 정하면 바꾸지 말 것 (해시 일관성 유지)
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
ANONYMIZATION_SALT=__REPLACE_ME__64_HEX_CHARS__

# 연구자 연락처 (HTTP From 헤더용 — 학술 목적 명시)
RESEARCHER_EMAIL=your_email@hufs.ac.kr

# 환경 식별자 (로그·메타데이터에 기록)
RESEARCH_ENV=local_dev    # local_dev | colab | hufs_server
