# =============================================
# DART 국민연금 알림 시스템 환경변수 템플릿
# 복사: cp .env.example .env  → 실제 값으로 교체
# =============================================

# DART OpenAPI 키 (opendart.fss.or.kr 회원가입 후 발급)
DART_API_KEY=여기에_DART_API_키

# 카카오 REST API 키 (developers.kakao.com > 내 애플리케이션 > 앱 키)
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키

# 카카오 Refresh Token (kakao_auth.py 실행 후 자동 저장됨)
KAKAO_REFRESH_TOKEN=

# Anthropic API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=여기에_Anthropic_API_키
