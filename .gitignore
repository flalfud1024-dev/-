# =============================================================
# 박사학위논문 저장소 .gitignore
# =============================================================

# === 환경변수 (절대 커밋 금지) ===
.env
.env.local
.env.*.local

# === 수집 원본 데이터 (용량·익명화 미검증 상태) ===
data/raw/
**/data/raw/
**/_snapshots/
**/_logs/
**/_state/

# === 처리된 데이터는 선택 ===
# data/processed/    # 익명화 검증 후 공개 가능

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# === 가상환경 ===
venv/
env/
.venv/
ENV/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# === Jupyter ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === 임시 파일 ===
*.tmp
*.bak
*~

# === Selenium 드라이버 캐시 ===
.wdm/

# === scraper.py 산출물·상태 ===
output/
logs/
state/
.auth/
